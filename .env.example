# Nusxa oling: cp .env.example .env va qiymatlarni to'ldiring
BOT_TOKEN=your_botfather_token_here
ADMIN_ID=your_telegram_user_id_here

# --- AI Test funksiyasi (3 ta faol taklifdan keyin ochiladi) ---
# Provider: "groq" (tavsiya, tez va bepul) yoki "gemini"
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Ixtiyoriy — model nomini o'zgartirmoqchi bo'lsangiz:
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_MODEL=gemini-1.5-flash
